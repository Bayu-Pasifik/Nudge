<?xml version="1.0" encoding="utf-8"?>
<!-- Sticky-note widget: up to 5 pinned cards, each with a tick button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="6dp"
        android:text="Nudge"
        android:textColor="#1E1B16"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Belum ada kartu ter-pin"
        android:textColor="#6B655A"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/row_0"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/done_0"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_check_bg"
            android:contentDescription="Selesai"
            android:gravity="center"
            android:textColor="#1E1B16"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/title_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#1E1B16"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_1"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/done_1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_check_bg"
            android:contentDescription="Selesai"
            android:gravity="center"
            android:textColor="#1E1B16"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/title_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#1E1B16"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_2"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/done_2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_check_bg"
            android:contentDescription="Selesai"
            android:gravity="center"
            android:textColor="#1E1B16"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/title_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#1E1B16"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_3"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/done_3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_check_bg"
            android:contentDescription="Selesai"
            android:gravity="center"
            android:textColor="#1E1B16"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/title_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#1E1B16"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/row_4"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/done_4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_check_bg"
            android:contentDescription="Selesai"
            android:gravity="center"
            android:textColor="#1E1B16"
            android:textSize="16sp" />
        <TextView
            android:id="@+id/title_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:textColor="#1E1B16"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
